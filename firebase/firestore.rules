rules_version = '2';
// Hanna Fitness — Firestore rules.
// Data: gyms/<GYM-CODE>/<table>/<row id>. Har device Anonymous sign-in karta hai.
// Firebase Console > Firestore Database > Rules mein yeh poora paste kar ke "Publish" karein.
service cloud.firestore {
  match /databases/{database}/documents {
    match /gyms/{gymCode}/{table}/{rowId} {
      allow read, write: if request.auth != null
        && table in ['settings', 'users', 'plans', 'trainers', 'members', 'memberships',
                     'payments', 'attendance', 'expenses', 'measurements'];
    }
    // Baqi sab band.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
